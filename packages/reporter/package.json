{
  "name": "@oss-error-registry/reporter",
  "version": "0.1.1",
  "description": "Deterministic pretty and JSON reporting for OSS Error Registry analyses.",
  "license": "MIT",
  "author": "Chetan Narayana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chetanx5/oss-error-registry.git",
    "directory": "packages/reporter"
  },
  "homepage": "https://github.com/chetanx5/oss-error-registry/tree/main/packages/reporter#readme",
  "bugs": {
    "url": "https://github.com/chetanx5/oss-error-registry/issues"
  },
  "keywords": [
    "diagnostics",
    "reporting",
    "json",
    "deterministic",
    "developer-tools"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@oss-error-registry/core": "workspace:*"
  }
}
