{
  "name": "oss-error-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first deterministic diagnostics for developer, build, and deployment errors.",
  "license": "MIT",
  "author": "Chetan Narayana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chetanx5/oss-error-registry.git"
  },
  "homepage": "https://github.com/chetanx5/oss-error-registry#readme",
  "bugs": {
    "url": "https://github.com/chetanx5/oss-error-registry/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "tsc -b --force --pretty false",
    "check": "pnpm run registry:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "cli": "node packages/cli/dist/bin.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "package:check": "node scripts/package-check.mjs",
    "registry:check": "node packages/registry/scripts/generate-registry-index.mjs --check",
    "registry:generate": "node packages/registry/scripts/generate-registry-index.mjs",
    "release:check": "pnpm run check && pnpm run package:check",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.check.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.4"
  }
}
